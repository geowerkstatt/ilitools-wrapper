INTERLIS 2.4;

!! A delivery that references a municipality it does not contain itself. With all objects accessible the
!! reference only resolves when the validator loads the municipality as reference data.
MODEL RefDataModel
  AT "mailto:info@geowerkstatt.ch"
  VERSION "2026-09-23" =

  TOPIC Municipalities =

    CLASS Municipality =
      Name: MANDATORY TEXT*40;
    END Municipality;

  END Municipalities;

  TOPIC Deliveries =
    DEPENDS ON RefDataModel.Municipalities;

    CLASS Parcel =
      Municipality: MANDATORY REFERENCE TO (EXTERNAL) RefDataModel.Municipalities.Municipality;
    END Parcel;

  END Deliveries;

END RefDataModel.
