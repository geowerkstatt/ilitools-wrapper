<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!-- https://checkstyle.org/filters/suppressionfilter.html -->
<suppressions>

    <!-- Disable checks for files generated from proto -->
    <suppress checks="[a-zA-Z0-9]*" files="[\\/]generated[\\/]sources[\\/]proto[\\/]" />

    <!-- Disable some checks for test classes -->
    <suppress checks="\w*Javadoc\w+Check|LineLengthCheck|VisibilityModifierCheck" files="[\\/]test[\\/]java[\\/]" />

</suppressions>
